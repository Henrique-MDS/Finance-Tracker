CREATE OR REPLACE FUNCTION update_goal_status()
RETURNS TRIGGER AS $$
BEGIN

    UPDATE "Goals"
    SET status = CASE
        WHEN NEW.now_value >= NEW.goal_value
            THEN 'concluido'::goal_status
        ELSE
            'em_andamento'::goal_status
    END
    WHERE id = NEW.id
      AND user_id = NEW.user_id;

    RETURN NEW;

END;
$$ LANGUAGE plpgsql;