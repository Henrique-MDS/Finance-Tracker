CREATE OR REPLACE FUNCTION get_monthly_comparative_receita_despesa(
    p_user_id UUID,
    p_type TEXT
)
RETURNS TABLE (
    month TIMESTAMP,
    total NUMERIC
)
LANGUAGE sql
STABLE
AS $$
    SELECT
        date_trunc('month', tran_date) AS month,
        SUM(
            value
        ) AS total
    FROM "Transactions"
    WHERE user_id = p_user_id
    AND type = p_type
    GROUP BY date_trunc('month', tran_date)
    ORDER BY month;
$$;