CREATE OR REPLACE FUNCTION get_month_balance(
  p_user_id uuid,
  p_start_date timestamptz,
  p_end_date timestamptz
)
RETURNS numeric
LANGUAGE sql
AS $$
  SELECT COALESCE(
    SUM(
      CASE
        WHEN type = 'Receita' THEN value
        ELSE -value
      END
    ),
    0
  )
  FROM "Transactions"
  WHERE user_id = p_user_id
    AND tran_date >= p_start_date
    AND tran_date < p_end_date;
$$;