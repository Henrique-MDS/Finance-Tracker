CREATE OR REPLACE FUNCTION public.handle_new_user()
RETURNS TRIGGER
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
BEGIN
    INSERT INTO public.profiles (
        id,
        name,
        avatar_url
    )
    VALUES (
        NEW.id,
        NEW.raw_user_meta_data->>'name',
        NULL
    );

    RETURN NEW;
END;
$$;