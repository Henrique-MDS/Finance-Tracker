CREATE OR REPLACE FUNCTION public.handle_new_user()
RETURNS TRIGGER
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
BEGIN
    INSERT INTO public.profiles (
        id,
        name,
        avatar_url
    )
    VALUES (
        NEW.id,
        NEW.raw_user_meta_data->>'name',
        NULL
    );

    INSERT INTO public."Categories" (
        user_id,
        name,
        icon,
        code,
        system
    )
    VALUES
        (NEW.id, 'Alimentação', 'utensils', 'FOOD', false),
        (NEW.id, 'Transporte', 'car', 'TRANSPORT', false),
        (NEW.id, 'Lazer', 'gamepad-2', 'LEISURE', false),
        (NEW.id, 'Aporte para Metas', 'target', 'GOAL_DEPOSIT', true);

    RETURN NEW;
END;
$$;