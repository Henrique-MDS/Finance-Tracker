CREATE OR REPLACE FUNCTION log_operation_function()
RETURNS TRIGGER AS $$
BEGIN

    IF TG_OP = 'INSERT' THEN

        INSERT INTO LogOperation (
            table_name,
            user_id,
            operation, 
            new_data
        )
        VALUES (
            TG_TABLE_NAME,
            NEW.user_id,
            TG_OP,
            to_jsonb(NEW)
        );

        RETURN NEW;

    ELSIF TG_OP = 'UPDATE' THEN

        INSERT INTO LogOperation (
            table_name,
            user_id,
            operation,
            old_data,
            new_data
        )
        VALUES (
            TG_TABLE_NAME,
            NEW.user_id,
            TG_OP,
            to_jsonb(OLD),
            to_jsonb(NEW)
        );

        RETURN NEW;

    ELSIF TG_OP = 'DELETE' THEN

        INSERT INTO LogOperation (
            table_name,
            user_id,
            operation,
            old_data
        )
        VALUES (
            TG_TABLE_NAME,
            OLD.user_id,
            TG_OP,
            to_jsonb(OLD)
        );

        RETURN OLD;

    END IF;

    RETURN NULL;
END;
$$ LANGUAGE plpgsql;