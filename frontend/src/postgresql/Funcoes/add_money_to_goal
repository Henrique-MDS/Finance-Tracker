CREATE OR REPLACE FUNCTION add_money_to_goal(
    p_goal_id uuid,
    p_user_id uuid,
    p_value numeric,
    p_tran_date date
)
RETURNS void
LANGUAGE plpgsql
AS $$
DECLARE
    v_category_id uuid;
    v_gerar_transacao boolean;
    v_nome_meta varchar;
    v_now_value numeric;
    v_goal_value numeric;
BEGIN

    SELECT id
    INTO v_category_id
    FROM "Categories"
    WHERE user_id = p_user_id
      AND code = 'GOAL_DEPOSIT';

    IF v_category_id IS NULL THEN
        RAISE EXCEPTION 'Categoria GOAL_DEPOSIT não encontrada.';
    END IF;

    SELECT COALESCE("IDGERTRANAUT", false)
    INTO v_gerar_transacao
    FROM "Params"
    WHERE user_id = p_user_id;

    SELECT title
    INTO v_nome_meta
    FROM "Goals"
    WHERE user_id = p_user_id
    AND id = p_goal_id;

    IF v_nome_meta IS NULL THEN
        v_nome_meta = 'Aporte para Meta';
    END IF;

    IF v_gerar_transacao THEN
        INSERT INTO "Transactions" (
            user_id,
            cat_id,
            value,
            type,
            "desc",
            tran_date
        )
        VALUES (
            p_user_id,
            v_category_id,
            p_value,
            'Despesa',
            v_nome_meta,
            p_tran_date
        );
    END IF;

    UPDATE "Goals"
    SET now_value = now_value + p_value
    WHERE id = p_goal_id
    AND user_id = p_user_id;

    SELECT 
        now_value,
        goal_value
    INTO
        v_now_value,
        v_goal_value
    FROM "Goals"
    WHERE id = p_goal_id
    AND user_id = p_user_id;

    IF v_now_value >= v_goal_value THEN
        UPDATE "Goals"
        SET status = 'concluido'
        WHERE id = p_goal_id
        AND user_id = p_user_id;
    END IF;

END;
$$;