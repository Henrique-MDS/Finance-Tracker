CREATE OR REPLACE FUNCTION add_money_to_goal(
    p_goal_id uuid,
    p_user_id uuid,
    p_value numeric,
    p_tran_date date
)
RETURNS void
LANGUAGE plpgsql
AS $$
DECLARE
    v_category_id uuid;
    v_gerar_transacao boolean;
BEGIN

    SELECT id
    INTO v_category_id
    FROM "Categories"
    WHERE user_id = p_user_id
      AND code = 'GOAL_DEPOSIT';

    IF v_category_id IS NULL THEN
        RAISE EXCEPTION 'Categoria GOAL_DEPOSIT não encontrada.';
    END IF;

    SELECT "IDGERTRANAUT"
    INTO v_gerar_transacao
    FROM "Params"
    WHERE user_id = p_user_id;

    IF v_gerar_transacao THEN
        INSERT INTO "Transactions" (
            user_id,
            cat_id,
            value,
            type,
            "desc",
            tran_date
        )
        VALUES (
            p_user_id,
            v_category_id,
            p_value,
            'Despesa',
            'Aporte para Meta',
            p_tran_date
        );
    END IF;

    UPDATE "Goals"
    SET now_value = now_value + p_value
    WHERE id = p_goal_id
      AND user_id = p_user_id;

END;
$$;