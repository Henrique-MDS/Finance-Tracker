
create or replace function public.user_has_verified_mfa()
returns boolean
language sql
security definer
set search_path = auth, pg_temp
stable
as $$
    select exists (
        select 1
        from auth.mfa_factors
        where user_id = auth.uid()
          and status = 'verified'
    );
$$;

revoke all on function public.user_has_verified_mfa() from public;
grant execute on function public.user_has_verified_mfa() to authenticated;

-------------Transactions

create policy "restringe acesso sem MFA"
on "Transactions"
as restrictive
for all
to authenticated
using (
    not public.user_has_verified_mfa()
    or (select auth.jwt()->>'aal') = 'aal2'
);

