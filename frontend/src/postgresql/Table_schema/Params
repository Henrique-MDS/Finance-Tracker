create table public."Params" (
  user_id uuid not null,
  "IDGERTRANAUT" boolean not null default false,
  created_at timestamp with time zone not null default now(),
  "LANGUAGE" text not null default 'pt-BR'::text,
  constraint "Params_pkey" primary key (user_id),
  constraint "Params_user_id_fkey" foreign KEY (user_id) references auth.users (id) on delete CASCADE,
  constraint params_language_check check (
    (
      "LANGUAGE" = any (array['pt-BR'::text, 'en-US'::text])
    )
  )
) TABLESPACE pg_default;